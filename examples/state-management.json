[
  {
    "id": "ex-state-tab",
    "type": "tab",
    "label": "Dapr: state save and get",
    "disabled": false,
    "info": "Saves a value to a Dapr state store, then reads it back. Set the connection node's Dapr host/port and app port before deploying. This flow uses a state store named \"statestore\" -- see examples/redis-statestore-component.yaml for a real Redis-backed component with that name. The function node between the two state nodes resets msg.dapr to { operation: \"get\", key: ... } -- otherwise the save node's own msg.dapr (operation: \"save\") would keep flowing downstream and the get node would try to save again."
  },
  {
    "id": "ex-state-conn",
    "type": "dapr-connection",
    "name": "sidecar",
    "daprHost": "",
    "daprPort": "",
    "bindAddress": "127.0.0.1",
    "appPort": "3000",
    "bodyLimitMb": "",
    "requestTimeoutSec": ""
  },
  {
    "id": "ex-state-inject",
    "type": "inject",
    "z": "ex-state-tab",
    "name": "create order",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "{\"orderId\":\"ORD-42\",\"status\":\"created\"}",
    "payloadType": "json",
    "x": 150,
    "y": 100,
    "wires": [["ex-state-save"]]
  },
  {
    "id": "ex-state-save",
    "type": "dapr-state",
    "z": "ex-state-tab",
    "name": "save order",
    "connection": "ex-state-conn",
    "operation": "save",
    "storeName": "statestore",
    "key": "order-42",
    "consistency": "",
    "concurrency": "",
    "ttlSeconds": "",
    "metadata": "{}",
    "x": 380,
    "y": 100,
    "wires": [["ex-state-clear"]]
  },
  {
    "id": "ex-state-clear",
    "type": "function",
    "z": "ex-state-tab",
    "name": "switch to get",
    "func": "msg.dapr = { operation: 'get', key: 'order-42' };\nreturn msg;",
    "outputs": 1,
    "x": 610,
    "y": 100,
    "wires": [["ex-state-get"]]
  },
  {
    "id": "ex-state-get",
    "type": "dapr-state",
    "z": "ex-state-tab",
    "name": "get order",
    "connection": "ex-state-conn",
    "operation": "get",
    "storeName": "statestore",
    "key": "",
    "consistency": "",
    "concurrency": "",
    "ttlSeconds": "",
    "metadata": "{}",
    "x": 840,
    "y": 100,
    "wires": [["ex-state-debug"]]
  },
  {
    "id": "ex-state-debug",
    "type": "debug",
    "z": "ex-state-tab",
    "name": "saved order",
    "active": true,
    "tosidebar": true,
    "console": false,
    "complete": "payload",
    "x": 1060,
    "y": 100
  }
]
