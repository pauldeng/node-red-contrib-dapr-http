# Dependencies
node_modules/

# Test / coverage output
coverage/
*.lcov
.nyc_output/

# Node-RED runtime artifacts created by the test harness
test/**/.userdir-*/
test/**/*.userdir/

# Playwright
test-results/
playwright-report/
.playwright/
test/e2e/screenshots/

# Provider-specific agent state — never shipped or committed
.claude/

# Local credential files for the optional MemoryDB tier — never committed
*.env
!*.example.env

# Logs and OS cruft
*.log
.DS_Store

# Process artifacts — the implementation plan and its reviews are local working
# notes, not shipped or versioned docs. They describe how the package was built
# and reviewed, which is history rather than a contract, and they were never in
# the npm tarball either (see package.json "files"). The durable, versioned
# instructions live in AGENTS.md; anything load-bearing belongs there or in
# docs/, not here. Do not re-add these to git.
PLAN_REVIEW_*.md
IMPLEMENTATION_REVIEW_*.md
IMPLEMENTATION_PLAN.md
