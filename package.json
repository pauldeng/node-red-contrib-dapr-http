{
  "name": "node-red-contrib-dapr",
  "version": "0.1.0",
  "description": "Node-RED nodes for Dapr pub/sub and service invocation over the Dapr HTTP sidecar API.",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "dapr"
  ],
  "engines": {
    "node": ">=24"
  },
  "node-red": {
    "version": ">=5.0.1 <6",
    "nodes": {
      "dapr-connection": "nodes/dapr-connection.js",
      "dapr-publish": "nodes/dapr-publish.js",
      "dapr-subscribe": "nodes/dapr-subscribe.js",
      "dapr-ack": "nodes/dapr-ack.js",
      "dapr-invoke": "nodes/dapr-invoke.js",
      "dapr-service": "nodes/dapr-service.js",
      "dapr-response": "nodes/dapr-response.js"
    }
  },
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-lines=90 --test-coverage-functions=90 --test-coverage-branches=85 \"test/unit/**/*.test.js\"",
    "test:runtime": "node --test \"test/runtime/**/*.test.js\"",
    "pretest:integration": "node test/helpers/pull-images.js",
    "test:integration": "node --test --test-concurrency=4 \"test/integration/**/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dapr/dapr": "3.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@nats-io/jetstream": "3.4.0",
    "@nats-io/transport-node": "3.4.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "node-red": "5.0.1",
    "prettier": "^3.3.0"
  }
}
