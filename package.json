{
  "name": "node-red-contrib-dapr",
  "version": "0.1.0",
  "description": "Node-RED nodes for Dapr pub/sub and service invocation over the Dapr HTTP sidecar API.",
  "private": true,
  "license": "UNLICENSED",
  "keywords": [
    "dapr"
  ],
  "engines": {
    "node": ">=24"
  },
  "node-red": {
    "version": ">=5.0.1 <6",
    "nodes": {}
  },
  "scripts": {
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:runtime": "node --test \"test/runtime/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dapr/dapr": "3.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "^9.9.0",
    "globals": "^15.9.0",
    "node-red": "5.0.1",
    "prettier": "^3.3.0"
  }
}
